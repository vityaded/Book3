# Copy this file to `.env` and fill in your secrets.

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_DEBUG=0
GEMINI_LOG_MAX_CHARS=4000
GEMINI_TEMPERATURE=0.0
GEMINI_TOP_P=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_THINKING_LEVEL=
GEMINI_RETRY_THINKING_LEVEL=medium
# Legacy Gemini 2.5 knob; prefer using GEMINI_THINKING_LEVEL for Gemini 3 models.
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_SEC=60
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SEC=1.5
GEMINI_SAFETY_BLOCK_ONLY_HIGH=1
GEMINI_CODE_EXECUTION=1
GEMINI_FALLBACK_MODEL=

# Flask
FLASK_SECRET_KEY=dev-change-me
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# Processing
MAX_PAGES=10
MAX_CONCURRENT_PAGES=2
MAX_IMAGE_DIM=1600
UPLOAD_MAX_MB=30
BOX_INSET_RATIO=0.04
FILTER_FILLED_BOXES=1
BOX_COORDINATE_SCALE=1000

# OCR / Debug
# NO_OCR=1 disables all OCR features (OCRmyPDF pre-pass, anchor snapping, OCR debug overlay).
NO_OCR=1
OCR_LANG=eng
OCR_TESSDATA_DIR=
OCR_MIN_WORD_HEIGHT_PX=0
DEBUG_OCR_LAYER=0
DEBUG_OCR_LAYER_ALL=0

# OCRmyPDF (PDF pre-pass)
OCRMY_PDF_ENABLED=1
OCRMY_PDF_REQUIRED=1
OCRMY_PDF_OPTIMIZE=0
OCRMY_PDF_SKIP_TEXT=1
OCRMY_PDF_OUTPUT_TYPE=pdf
OCRMY_PDF_PDFA_IMAGE_COMPRESSION=lossless
OCRMY_PDF_LOG_OUTPUT=0
OCRMY_PDF_REMOVE_VECTORS=0
OCRMY_PDF_ROTATE_PAGES=0
OCRMY_PDF_DESKEW=0
OCRMY_PDF_CLEAN=0
OCRMY_PDF_REMOVE_BACKGROUND=0
OCRMY_PDF_OVERSAMPLE=
OCRMY_PDF_TESSERACT_CONFIG=
OCRMY_PDF_CHAR_WHITELIST=
OCRMY_PDF_TESSERACT_PSM=
OCRMY_PDF_TESSERACT_OEM=
OCRMY_PDF_TESSERACT_THRESHOLDING=
OCRMY_PDF_USER_WORDS=
OCRMY_PDF_USER_PATTERNS=

# Anchor snapping
ANCHOR_GAP=0.006
ANCHOR_MAX_SHIFT_X=0.25
ANCHOR_MAX_SHIFT_Y=0.15
ANCHOR_FUZZY_RATIO=0.78
ANCHOR_RIGHT_TOLERANCE=0.02
ANCHOR_LINE_DY_MAX=0.03
ANCHOR_LINE_DY_MIN=0.01
ANCHOR_LINE_DY_MULT=3.0
ANCHOR_TARGET_PADDING_RATIO=0.01

# Computer vision snap (ink-aware left edge)
CV_SCAN_ENABLED=1
CV_SEARCH_WIDTH_PX=220
CV_PADDING_PX=6
CV_MIN_WIDTH_PX=14
CV_MIN_WIDTH_RATIO=0.6
CV_THRESHOLD=200
CV_MIDDLE_BAND_RATIO=0.10
CV_EDGE_SCAN_PX=0
CV_DEBUG=0
CV_CAP_HEIGHT_ENABLED=1
CV_CAP_HEIGHT_SCAN_UP_RATIO=2.2
CV_CAP_HEIGHT_SCAN_DOWN_RATIO=0.6
CV_CAP_HEIGHT_ROW_RATIO_MIN=0.03
CV_CAP_HEIGHT_ROW_RATIO_SCALE=0.45
CV_CAP_HEIGHT_MIN_PX=6
CV_CAP_HEIGHT_MAX_SCALE=2.2
CV_CAP_HEIGHT_MAX_SHIFT_RATIO=1.2
